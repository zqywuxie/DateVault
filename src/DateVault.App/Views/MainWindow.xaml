<Window x:Class="DateVault.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DateVault.App.ViewModels"
        mc:Ignorable="d"
        Title="DateVault"
        Width="760"
        Height="540"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="Manual"
        Opacity="0"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="TreeViewItem">
      <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown" />
      <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type vm:FileTreeNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <Border x:Name="RowChrome"
              Padding="10,7"
              Background="Transparent"
              CornerRadius="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="42"
                  Height="20"
                  CornerRadius="10">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#F1F3F6" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Background" Value="#EAF3FF" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#5C6270"
                       Text="{Binding TypeLabel}" />
          </Border>

          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="{Binding Name}" />
        </Grid>
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
          <Setter TargetName="RowChrome" Property="Background" Value="#F5F7FA" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
          <Setter TargetName="RowChrome" Property="Background" Value="#E8F2FF" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Border x:Name="WindowFrameBorder"
          Style="{StaticResource WindowSurfaceBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="16,8,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Style="{StaticResource WindowCloseButtonStyle}"
                  ToolTip="关闭"
                  Click="WindowCloseButton_Click" />
          <Button Style="{StaticResource WindowMinimizeButtonStyle}"
                  ToolTip="最小化"
                  Click="WindowMinimizeButton_Click" />
          <Button Style="{StaticResource WindowMaximizeButtonStyle}"
                  Margin="0"
                  ToolTip="最大化"
                  Click="WindowMaximizeButton_Click" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   Style="{StaticResource WindowCaptionTextStyle}"
                   Text="DateVault" />

        <TextBlock Grid.Column="2"
                   Style="{StaticResource WindowCaptionTextStyle}"
                   Text="{Binding AppVersion, StringFormat=v{0}}" />
      </Grid>

      <DockPanel Grid.Row="1">
    <Border DockPanel.Dock="Top"
            Margin="24,10,24,14"
            Padding="22,20"
            Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock FontSize="24"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="DateVault" />
          <Border Margin="12,0,0,0"
                  Padding="12,6"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="12">
            <TextBlock Foreground="{StaticResource AccentBrush}"
                       Text="{Binding TodayRelativePath, StringFormat=今日目录: {0}}" />
          </Border>
        </StackPanel>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   MaxWidth="420"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding RootPath, StringFormat=根目录: {0}}" />

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal">
          <Button Click="SelectRootButton_Click"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Content="选择根目录" />
          <Button Click="OpenTodayButton_Click"
                  Content="打开今日目录" />
          <Button Click="CreateFolderButton_Click"
                  Content="新建文件夹" />
          <Button Click="RefreshButton_Click"
                  Content="刷新" />
          <Button Click="SettingsButton_Click"
                  Content="设置" />
          <Button Click="AboutButton_Click"
                  Content="关于" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Margin="24,0,24,24"
            Padding="14,9"
            Style="{StaticResource SubtleCardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding StatusText}" />

        <TextBlock Grid.Column="1"
                   Margin="0,0,14,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding AppVersion, StringFormat=版本: {0}}" />

        <TextBlock Grid.Column="2"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding ArchiveCountToday, StringFormat=今日已归档: {0}}" />
      </Grid>
    </Border>

    <Grid Margin="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="312" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="18"
              Style="{StaticResource CardBorderStyle}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,0,0,14"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="文件树" />

          <Grid>
          <TreeView x:Name="ArchiveTreeView"
                    Background="Transparent"
                    BorderThickness="0"
                    KeyDown="ArchiveTreeView_KeyDown"
                    ItemsSource="{Binding TreeNodes}"
                    SelectedItemChanged="ArchiveTreeView_SelectedItemChanged">
            <TreeView.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111" />
              <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
            </TreeView.Resources>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="打开"
                            Click="OpenMenuItem_Click" />
                  <MenuItem Header="打开所在位置"
                            Click="RevealMenuItem_Click" />
                  <MenuItem Header="复制路径"
                            Click="CopyPathMenuItem_Click" />
                  <MenuItem Header="删除"
                            Click="DeleteMenuItem_Click" />
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>

            <Border Padding="18"
                    Background="#F8F8FA"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    IsHitTestVisible="False">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTreeItems}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <Border Width="52"
                        Height="52"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="16">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="22"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="D" />
                </Border>
                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="这里还没有内容"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding TreeEmptyMessage}"
                           TextWrapping="Wrap"
                           MaxWidth="220"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="176" />
          <RowDefinition Height="18" />
          <RowDefinition Height="196" />
          <RowDefinition Height="18" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="DropAreaBorder"
                Grid.Row="0"
                Padding="28"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#CFE2FF"
                BorderThickness="1"
                CornerRadius="22"
                AllowDrop="True"
                DragEnter="DropAreaBorder_DragEnter"
                DragOver="DropAreaBorder_DragOver"
                DragLeave="DropAreaBorder_DragLeave"
                Drop="DropAreaBorder_Drop">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="快速归档" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="将文件或文件夹拖到这里，自动移动到目标目录。" />
            <Border Margin="0,14,0,0"
                    Padding="12,7"
                    HorizontalAlignment="Left"
                    Background="#FFFFFF"
                    BorderBrush="#D9E6F6"
                    BorderThickness="1"
                    CornerRadius="12">
              <TextBlock Foreground="{StaticResource AccentBrush}"
                         Text="{Binding ArchiveTargetPath, StringFormat=归档目标: {0}}" />
            </Border>
            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding ArchiveOrganizationSummary}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="18"
                Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="当前选中" />

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding SelectedName, StringFormat=名称: {0}}" />

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding SelectedPath, StringFormat=路径: {0}}" />

            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button Click="OpenMenuItem_Click"
                      Content="打开" />
              <Button Click="RevealMenuItem_Click"
                      Content="打开位置" />
              <Button Click="CopyPathMenuItem_Click"
                      Content="复制路径" />
              <Button Click="DeleteMenuItem_Click"
                      Content="删除" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="18"
                Style="{StaticResource CardBorderStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,14"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="最近操作" />

            <ListBox ItemsSource="{Binding LogLines}"
                     MouseDoubleClick="LogListBox_MouseDoubleClick"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LogItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28"
                            Height="28"
                            Margin="0,0,12,0"
                            CornerRadius="10">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                              <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                              <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Text="{Binding BadgeText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding MessageText}"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Margin="0,6,0,0"
                                 Text="{Binding TimestampText}"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="8,4"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanReveal}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding ActionHintText}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
      </DockPanel>
    </Grid>
  </Border>
</Window>
