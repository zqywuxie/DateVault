<Window x:Class="DateVault.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DateVault.App.ViewModels"
        mc:Ignorable="d"
        Title="DateVault"
        Width="760"
        Height="540"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="Manual"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Opacity="0"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="TreeViewItem">
      <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown" />
      <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type vm:FileTreeNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <Border x:Name="RowChrome"
              Padding="8,6"
              Background="Transparent"
              CornerRadius="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="6"
                  Height="6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  CornerRadius="3">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding MarkerColor}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="#7C8594" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontFamily="Microsoft YaHei"
                     FontSize="12.5"
                     FontWeight="Normal"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="{Binding Name}" />
        </Grid>
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
          <Setter TargetName="RowChrome" Property="Background" Value="#F5F7FA" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
          <Setter TargetName="RowChrome" Property="Background" Value="#E8F2FF" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <Style x:Key="ColumnSplitterStyle" TargetType="GridSplitter">
      <Setter Property="Width" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ShowsPreview" Value="True" />
      <Setter Property="ResizeDirection" Value="Columns" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="SplitterChrome"
                      Width="4"
                      Margin="4,12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#E3E7EE"
                      CornerRadius="2" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SplitterChrome" Property="Background" Value="#C9D3E1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SplitterChrome" Property="Background" Value="#B8C7DC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="12,8,12,12">
    <Border DockPanel.Dock="Top"
            Margin="0,0,0,10"
            Padding="18,16"
            Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
          <StackPanel>
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="DateVault" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="按日期整理文件与文件夹" />
          </StackPanel>

          <Border Margin="12,0,0,0"
                  Padding="10,5"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="10"
                  VerticalAlignment="Center">
            <TextBlock Foreground="{StaticResource AccentBrush}"
                       Text="{Binding TodayRelativePath, StringFormat=今日目录: {0}}" />
          </Border>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   MaxWidth="420"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding RootPath, StringFormat=根目录: {0}}" />

        <WrapPanel Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Margin="0,14,0,0">
          <Button Click="SelectRootButton_Click"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Content="选择根目录" />
          <Button Click="OpenTodayButton_Click"
                  Content="打开今日目录" />
          <Button Click="CreateFolderButton_Click"
                  Content="新建文件夹" />
          <Button Click="RefreshButton_Click"
                  Content="刷新" />
          <Button Click="SettingsButton_Click"
                  Content="设置" />
          <Button Click="AboutButton_Click"
                  Content="关于" />
        </WrapPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="12,8"
            Style="{StaticResource SubtleCardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding StatusText}" />

        <TextBlock Grid.Column="1"
                   Margin="0,0,12,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding AppVersion, StringFormat=版本: {0}}" />

        <TextBlock Grid.Column="2"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding ArchiveCountToday, StringFormat=今日已归档: {0}}" />
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="286" MinWidth="220" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="16"
              Style="{StaticResource CardBorderStyle}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,0,0,12"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="文件树" />

          <Grid>
            <TreeView x:Name="ArchiveTreeView"
                      Background="Transparent"
                      BorderThickness="0"
                      KeyDown="ArchiveTreeView_KeyDown"
                      ItemsSource="{Binding TreeNodes}"
                      SelectedItemChanged="ArchiveTreeView_SelectedItemChanged">
              <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
              </TreeView.Resources>
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="打开"
                            Click="OpenMenuItem_Click" />
                  <MenuItem Header="打开所在位置"
                            Click="RevealMenuItem_Click" />
                  <MenuItem Header="复制路径"
                            Click="CopyPathMenuItem_Click" />
                  <MenuItem Header="删除"
                            Click="DeleteMenuItem_Click" />
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>

            <Border Padding="16"
                    Background="#F8F8FA"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    IsHitTestVisible="False">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTreeItems}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <Border Width="46"
                        Height="46"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="14">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="D" />
                </Border>
                <TextBlock Margin="0,12,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           Text="这里还没有内容" />
                <TextBlock Margin="0,8,0,0"
                           MaxWidth="220"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding TreeEmptyMessage}" />
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Style="{StaticResource ColumnSplitterStyle}" />

      <ScrollViewer Grid.Column="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False">
        <Grid Margin="0,0,2,0">
          <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

        <Border x:Name="DropAreaBorder"
                Grid.Row="0"
                MinHeight="148"
                Padding="22"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#CFE2FF"
                BorderThickness="1"
                CornerRadius="20"
                AllowDrop="True"
                DragEnter="DropAreaBorder_DragEnter"
                DragOver="DropAreaBorder_DragOver"
                DragLeave="DropAreaBorder_DragLeave"
                Drop="DropAreaBorder_Drop">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="快速归档" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="将文件或文件夹拖到这里，自动移动到目标目录。"
                       TextWrapping="Wrap" />
            <Border Margin="0,14,0,0"
                    Padding="12,7"
                    HorizontalAlignment="Left"
                    Background="#FFFFFF"
                    BorderBrush="#D9E6F6"
                    BorderThickness="1"
                    CornerRadius="12">
              <TextBlock Foreground="{StaticResource AccentBrush}"
                         Text="{Binding ArchiveTargetPath, StringFormat=归档目标: {0}}" />
            </Border>
            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding ArchiveOrganizationSummary}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                MinHeight="168"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="当前选中" />

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding SelectedName, StringFormat=名称: {0}}" />

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding SelectedPath, StringFormat=路径: {0}}" />

            <WrapPanel Grid.Row="3"
                       Margin="0,14,0,0">
              <Button Click="OpenMenuItem_Click"
                      Content="打开" />
              <Button Click="RevealMenuItem_Click"
                      Content="打开位置" />
              <Button Click="CopyPathMenuItem_Click"
                      Content="复制路径" />
              <Button Click="DeleteMenuItem_Click"
                      Content="删除" />
            </WrapPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4"
                MinHeight="184"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,12"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="最近操作" />

            <ListBox MinHeight="136"
                     ItemsSource="{Binding LogLines}"
                     MouseDoubleClick="LogListBox_MouseDoubleClick"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LogItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28"
                            Height="28"
                            Margin="0,0,12,0"
                            CornerRadius="10">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                              <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                              <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Text="{Binding BadgeText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding MessageText}"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Margin="0,6,0,0"
                                 Text="{Binding TimestampText}"
                                 FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="8,4"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanReveal}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 Text="{Binding ActionHintText}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
