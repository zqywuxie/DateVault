<Window x:Class="DateVault.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="400"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Border Style="{StaticResource WindowSurfaceBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="14,8,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource WindowCloseButtonStyle}"
                ToolTip="关闭"
                Click="CancelButton_Click" />

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   Style="{StaticResource WindowCaptionTextStyle}"
                   Text="确认" />
      </Grid>

      <Border Grid.Row="1"
              Width="52"
              Height="52"
              Margin="22,12,22,0"
              HorizontalAlignment="Left"
              Background="{StaticResource DangerSoftBrush}"
              CornerRadius="16">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DangerBrush}"
                   Text="!" />
      </Border>

      <TextBlock Grid.Row="2"
                 Margin="22,16,22,0"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 Text="{Binding TitleText}" />

      <TextBlock Grid.Row="3"
                 Margin="22,10,22,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="{Binding MessageText}"
                 TextWrapping="Wrap" />

      <StackPanel Grid.Row="4"
                  Margin="22,20,22,22"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Width="88"
                Margin="0,0,10,0"
                IsCancel="True"
                Click="CancelButton_Click"
                Content="取消" />
        <Button Width="104"
                Style="{StaticResource DangerButtonStyle}"
                IsDefault="True"
                Click="ConfirmButton_Click"
                Content="{Binding ConfirmText}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
