<Window x:Class="DateVault.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 DateVault"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
  <Border Margin="18"
          Padding="24"
          Style="{StaticResource CardBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <Border Width="64"
                Height="64"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="20">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     Text="D" />
        </Border>

        <TextBlock Margin="0,18,0,0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Text="{Binding ProductName}" />

        <TextBlock Margin="0,8,0,0"
                   FontSize="13"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{Binding Description}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1"
              Margin="0,18,0,0"
              Padding="14"
              Style="{StaticResource SubtleCardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                     Text="版本" />
          <TextBlock Grid.Column="1"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="{Binding Version}" />

          <TextBlock Grid.Row="1"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="发布方式" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="Windows 本地轻量桌面应用" />

          <TextBlock Grid.Row="2"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="发布者" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="{Binding Company}" />
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Margin="0,16,0,0"
              Padding="14"
              Style="{StaticResource SubtleCardBorderStyle}">
        <StackPanel>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Text="更新说明" />
          <TextBlock Margin="0,8,0,0"
                     FontSize="12"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="当前版本暂未接入在线更新服务。后续升级建议直接使用新的安装包覆盖安装，配置会保留在用户目录。"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="3"
                 Margin="0,16,0,0"
                 VerticalAlignment="Top"
                 FontSize="12"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="DateVault 以日期目录为核心，支持按类型分流、自定义规则、便携分发和单用户安装。"
                 TextWrapping="Wrap" />

      <StackPanel Grid.Row="4"
                  Margin="0,18,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Padding="16,10"
                Margin="0,0,10,0"
                Click="CheckUpdateButton_Click"
                Content="检查更新" />
        <Button Width="88"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True"
                Click="CloseButton_Click"
                Content="关闭" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
