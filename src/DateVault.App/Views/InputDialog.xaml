<Window x:Class="DateVault.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建文件夹"
        Width="360"
        Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Border Style="{StaticResource WindowSurfaceBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="14,8,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource WindowCloseButtonStyle}"
                ToolTip="关闭"
                Click="CancelButton_Click" />

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   Style="{StaticResource WindowCaptionTextStyle}"
                   Text="新建文件夹" />
      </Grid>

      <TextBlock Grid.Row="1"
                 Margin="20,12,20,0"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 Text="新建文件夹" />

      <TextBlock Grid.Row="2"
                 Margin="20,8,20,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="在当前选中目录或今日目录下创建新的子文件夹。"
                 TextWrapping="Wrap" />

      <TextBox x:Name="FolderNameTextBox"
               Grid.Row="3"
               Margin="20,16,20,0"
               Height="42"
               VerticalContentAlignment="Center" />

      <StackPanel Grid.Row="4"
                  Margin="20,18,20,20"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Width="84"
                Margin="0,0,10,0"
                IsCancel="True"
                Click="CancelButton_Click"
                Content="取消" />
        <Button Width="84"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True"
                Click="ConfirmButton_Click"
                Content="确定" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
