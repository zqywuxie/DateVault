<Window x:Class="DateVault.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="760"
        MinWidth="560"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Window.Resources>
    <SolidColorBrush x:Key="ValidationErrorBrush" Color="#C9342F" />
    <SolidColorBrush x:Key="ValidationSoftBrush" Color="#FFF4F2" />
    <SolidColorBrush x:Key="ValidationBorderBrush" Color="#F1CBC7" />

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SectionHintTextStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsOptionRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome"
                    Padding="16"
                    Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Margin="0,0,16,0" />

                <Grid Grid.Column="1"
                      Width="20"
                      Height="20"
                      VerticalAlignment="Top">
                  <Ellipse Stroke="{StaticResource HairlineBrush}"
                           StrokeThickness="1.5"
                           Fill="White" />
                  <Ellipse x:Name="Indicator"
                           Width="8"
                           Height="8"
                           Fill="{StaticResource AccentBrush}"
                           Opacity="0" />
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#F4F6FA" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D7DAE3" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource WindowSurfaceBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="14,8,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource WindowCloseButtonStyle}"
                ToolTip="关闭"
                Click="CancelButton_Click" />

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   Style="{StaticResource WindowCaptionTextStyle}"
                   Text="设置" />
      </Grid>

      <Border Grid.Row="1"
              Margin="18,8,18,18"
              Padding="26"
              Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 Text="DateVault 设置" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="把常用路径和默认归档方式整理清楚，后续操作会更顺手。"
                   TextWrapping="Wrap" />
        <Border Margin="0,14,0,0"
                Padding="12,8"
                HorizontalAlignment="Left"
                Background="{StaticResource SurfaceSoftBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <TextBlock x:Name="SettingsSummaryTextBlock"
                     FontSize="12"
                     Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    Margin="0,22,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Padding="18"
                  Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="归档根目录" />
              <TextBlock Style="{StaticResource SectionHintTextStyle}"
                         Text="所有日期目录都会建立在这里。建议选择固定、易于备份的位置。"/>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="RootPathTextBox"
                         Height="42"
                         VerticalContentAlignment="Center"
                         TextChanged="RootPathTextBox_TextChanged" />

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="18,10"
                        Click="BrowseButton_Click"
                        Content="浏览" />
              </Grid>

              <TextBlock x:Name="RootPathHintTextBlock"
                         Style="{StaticResource SectionHintTextStyle}"
                         Text="当前目录会作为默认归档入口。" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="默认归档方式" />
              <TextBlock Style="{StaticResource SectionHintTextStyle}"
                         Text="选择拖拽文件时优先落到哪里。建议按你平时的整理习惯来设定。" />

              <StackPanel Margin="0,14,0,0">
                <RadioButton x:Name="TodayDirectoryRadioButton"
                             GroupName="TargetMode"
                             Checked="TargetModeRadioButton_Checked"
                             Style="{StaticResource SettingsOptionRadioButtonStyle}">
                  <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="始终归档到今天目录" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="适合把当天新增内容集中收纳，结构更稳定。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SelectedDirectoryRadioButton"
                             GroupName="TargetMode"
                             Checked="TargetModeRadioButton_Checked"
                             Margin="0"
                             Style="{StaticResource SettingsOptionRadioButtonStyle}">
                  <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="优先归档到当前选中目录" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="适合边浏览边整理，减少来回切换目录。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="文件整理方式" />
              <TextBlock Style="{StaticResource SectionHintTextStyle}"
                         Text="控制文件落到目标目录后是否继续按数据类型分流。需要轻量时建议只保留两种模式。" />

              <StackPanel Margin="0,14,0,0">
                <RadioButton x:Name="DirectArchiveRadioButton"
                             GroupName="ArchiveOrganizationMode"
                             Checked="ArchiveOrganizationModeRadioButton_Checked"
                             Style="{StaticResource SettingsOptionRadioButtonStyle}">
                  <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="直接归档到目标目录" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="保持目录结构最简单，适合你已经手动分好目录的情况。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ByDataTypeArchiveRadioButton"
                             GroupName="ArchiveOrganizationMode"
                             Checked="ArchiveOrganizationModeRadioButton_Checked"
                             Margin="0"
                             Style="{StaticResource SettingsOptionRadioButtonStyle}">
                  <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="按数据类型自动归档" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="自动创建图片、文档、视频、音频、压缩包、代码等子文件夹。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="自定义类型规则" />
              <TextBlock Style="{StaticResource SectionHintTextStyle}"
                         Text="每行一条规则，格式为 .扩展名=文件夹名。也支持多个扩展名共用一个文件夹，例如 .md,.txt=笔记。" />

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="RuleTemplateComboBox"
                          Height="40"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">
                  <ComboBoxItem Content="选择规则模板" Tag="" />
                  <ComboBoxItem Content="设计素材" Tag="DesignAssets" />
                  <ComboBoxItem Content="开发工程" Tag="Development" />
                  <ComboBoxItem Content="影音收藏" Tag="MediaLibrary" />
                </ComboBox>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="16,10"
                        Click="ApplyTemplateButton_Click"
                        Content="替换" />

                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="16,10"
                        Click="AppendTemplateButton_Click"
                        Content="追加" />
              </Grid>

              <TextBox x:Name="CustomRulesTextBox"
                       Margin="0,14,0,0"
                       MinHeight="124"
                        AcceptsReturn="True"
                       TextChanged="CustomRulesTextBox_TextChanged"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" />

              <TextBlock x:Name="CustomRulesStatusTextBlock"
                         Margin="0,10,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="未填写自定义规则时，将使用系统内置分类。"
                         TextWrapping="Wrap" />

              <Border x:Name="CustomRulesErrorBorder"
                      Margin="0,10,0,0"
                      Padding="10,8"
                      Background="{StaticResource ValidationSoftBrush}"
                      BorderBrush="{StaticResource ValidationBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Visibility="Collapsed">
                <TextBlock x:Name="CustomRulesErrorTextBlock"
                           FontSize="12"
                           Foreground="{StaticResource ValidationErrorBrush}"
                           TextWrapping="Wrap" />
              </Border>

              <TextBlock Margin="0,10,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="示例：.psd=设计源文件　　.ai,.sketch,.fig=设计工程"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="18"
                  Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="重名处理策略" />
              <TextBlock Style="{StaticResource SectionHintTextStyle}"
                         Text="当前版本保持轻量，只提供安全的自动重命名策略，避免误覆盖。" />

              <DockPanel Margin="0,14,0,0"
                         LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="遇到重名时自动重命名" />
                <Border Margin="10,0,0,0"
                        Padding="10,4"
                        Background="#EEF4FF"
                        BorderBrush="#D8E7FF"
                        BorderThickness="1"
                        CornerRadius="10"
                        DockPanel.Dock="Right">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="固定" />
                </Border>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              Margin="0,18,0,0"
              Padding="0,16,0,0"
              BorderBrush="{StaticResource HairlineBrush}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button Padding="16,10"
                    Click="ImportConfigButton_Click"
                    Content="导入配置" />
            <Button Padding="16,10"
                    Click="ExportConfigButton_Click"
                    Content="导出配置" />
          </StackPanel>

          <TextBlock x:Name="FooterHintTextBlock"
                     Grid.Column="1"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="设置会立即用于后续归档，不影响已有文件。" />

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right">
        <Button Width="88"
                Margin="0,0,10,0"
                IsCancel="True"
                Click="CancelButton_Click"
                Content="取消" />
        <Button x:Name="SaveButton"
                Width="88"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True"
                Click="SaveButton_Click"
                Content="保存" />
          </StackPanel>
        </Grid>
      </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
